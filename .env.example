# API keys can also be entered in the app (AI Settings). Only the keys for the
# providers you select are needed.

# Google Gemini (object detection and/or image completion)
VITE_GEMINI_API_KEY=

# Anthropic Claude (object detection)
VITE_ANTHROPIC_API_KEY=

# OpenAI (object detection and/or image completion)
VITE_OPENAI_API_KEY=

# Hugging Face Token (recommended; ZeroGPU usage on Hugging Face Spaces counts against your own quota.
# Required for TRELLIS.2)
VITE_HF_TOKEN=
